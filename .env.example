# ACEDRA — variables read by docker compose (copy to .env in this folder).
# Backend settings for running without Docker live in backend/.env.example.
POSTGRES_USER=acedra
POSTGRES_PASSWORD=acedra-dev-password
POSTGRES_DB=acedra
SECRET_KEY=dev-only-insecure-secret-change-me
SEED_DEMO_DATA=true
LLM_PROVIDER=none
EMBEDDING_PROVIDER=lexical
EMAIL_PROVIDER=log
