# ACEDRA backend — local development. Copy to backend/.env
ENVIRONMENT=development
SECRET_KEY=dev-only-insecure-secret-change-me
PUBLIC_APP_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# SQLite for quick local runs; use PostgreSQL for anything shared.
DATABASE_URL=sqlite:///./acedra.db
# DATABASE_URL=postgresql+psycopg://acedra:acedra-dev-password@localhost:5432/acedra

ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

LLM_PROVIDER=none
EMBEDDING_PROVIDER=lexical
EMAIL_PROVIDER=log

# Legal acceptance: the web app always asks users to accept new Terms/Privacy versions. Set true to also make the
# API refuse workspace requests (HTTP 428) until the current versions are accepted.
LEGAL_ACCEPTANCE_ENFORCED=false
# Public contact form rate limit per client address.
CONTACT_RATE_LIMIT=5/hour
