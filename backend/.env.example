# Environment Configuration
PROJECT_NAME="Smart Campus Intelligence"
VERSION="0.1.0"
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

# Security
SECRET_KEY=change-this-in-production-super-secret-key-32-chars-min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173","http://127.0.0.1:3000"]

# Database
# For Docker / Local PostgreSQL with pgvector:
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/smart_campus
# Standalone local fallback if PostgreSQL is not active:
# DATABASE_URL=sqlite:///./smart_campus.db

# Rate Limiting
RATE_LIMIT_DEFAULT="100/minute"
AUTH_RATE_LIMIT="15/minute"
