# ACEDRA frontend build-time settings. Copy to frontend/.env.local (development) or frontend/.env.production
# (production build). Values are compiled into the public site, so never put secrets here.

# Organisation details shown on the website (About, Contact, Security, Accessibility, footer).
# Leave empty until confirmed: each one is then shown as a clearly marked "[To be configured: …]" placeholder.
# The development server shows labelled demonstration contact details (Bengaluru, 9999999999,
# hello@acedra.example, https://acedra.example) while the four contact fields below are all empty.
VITE_OPERATOR_NAME=
VITE_OPERATOR_ADDRESS=
VITE_SUPPORT_EMAIL=
VITE_SUPPORT_PHONE=
VITE_OPERATOR_WEBSITE=
VITE_SECURITY_EMAIL=
VITE_ACCESSIBILITY_EMAIL=

# Show the synthetic demo accounts on the sign-in page in a production build (development builds always show them).
VITE_SHOW_DEMO_ACCOUNTS=false
