# ==============================================================================
# Smart Campus Intelligence — Production Environment Configuration Template
# COPY TO: .env.production AND CONFIGURE SECRETS BEFORE DEPLOYMENT
# ==============================================================================

# Core Application Settings
PROJECT_NAME="Smart Campus Intelligence"
VERSION="1.0.0"
ENVIRONMENT="production"
DEBUG="False"

# Cryptographic Security (CRITICAL: Generate with: openssl rand -hex 32)
SECRET_KEY="REPLACE_WITH_SECURE_64_CHAR_HEX_KEY_GENERATE_VIA_OPENSSL"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="60"
REFRESH_TOKEN_EXPIRE_DAYS="7"

# PostgreSQL Database Configuration with pgvector
POSTGRES_USER="campus_admin"
POSTGRES_PASSWORD="REPLACE_WITH_STRONG_DATABASE_PASSWORD"
POSTGRES_DB="smart_campus_production"
DATABASE_URL="postgresql+psycopg://campus_admin:REPLACE_WITH_STRONG_DATABASE_PASSWORD@db:5432/smart_campus_production"

# Network & CORS Security (JSON array of allowed production domains)
CORS_ORIGINS=["https://campus.institution.edu","http://localhost","http://localhost:80"]

# Rate Limiting
RATE_LIMIT_DEFAULT="120/minute"

# Conversational AI & LLM Providers (Optional: defaults to built-in heuristic/RAG grounding if empty)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""

# Vector & Document Indexing
EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"
DOCUMENT_STORAGE_DIR="/app/storage/documents"
MAX_UPLOAD_SIZE_MB="15"
ALLOWED_EXTENSIONS=["pdf","docx","txt","md"]

# Institutional Notification Dispatch (SMTP Configuration)
SMTP_HOST="smtp.institution.edu"
SMTP_PORT="587"
SMTP_USER="notifications@campus.institution.edu"
SMTP_PASSWORD=""
EMAILS_FROM_EMAIL="notifications@campus.institution.edu"
EMAILS_FROM_NAME="Smart Campus Intelligence"
