# ACEDRA — production environment template. Copy to .env.production and fill in every value.
# The API refuses to start in production with an insecure SECRET_KEY, wildcard CORS, SQLite or a non-https
# PUBLIC_APP_URL.

ENVIRONMENT=production
SECRET_KEY=            # python -c "import secrets; print(secrets.token_urlsafe(48))"
PUBLIC_APP_URL=https://acedra.your-institution.example
CORS_ORIGINS=["https://acedra.your-institution.example"]

# TLS: directory holding fullchain.pem and privkey.pem for the public hostname (mounted read-only into Nginx).
TLS_CERT_DIR=./docker/certs
# Directory served at /.well-known/acme-challenge/ for Let's Encrypt HTTP-01 renewals.
ACME_WEBROOT=./docker/acme

POSTGRES_USER=acedra
POSTGRES_PASSWORD=     # strong, unique; letters and digits only (it is placed inside a connection URL)
POSTGRES_DB=acedra

# Language model (optional). With LLM_PROVIDER=none the assistant gives labelled, extractive answers only.
LLM_PROVIDER=none      # none | openai_compatible | anthropic | ollama
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=

# Retrieval. "lexical" is keyword retrieval (not semantic). Reindex documents after changing provider.
EMBEDDING_PROVIDER=lexical   # lexical | openai_compatible | ollama
EMBEDDING_MODEL=
EMBEDDING_API_KEY=

# Email delivery for invitations, verification, password reset and notifications
# Production always uses SMTP: the API refuses to start with EMAIL_PROVIDER=log or the built-in sender address.
EMAIL_FROM=ACEDRA <no-reply@your-institution.example>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Legal acceptance: refuse workspace API requests (HTTP 428) until a user has accepted the current Terms and
# Privacy Policy versions. Recommended in production; the web app prompts for acceptance either way.
LEGAL_ACCEPTANCE_ENFORCED=true
CONTACT_RATE_LIMIT=5/hour
